@{
    ViewData["Title"] = "Registrar Solicitud de Crédito";
}

<h1>Registrar Solicitud de Crédito</h1>

@if (ViewBag.Exito != null)
{
    <div class="alert alert-success">@ViewBag.Exito</div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="Crear" method="post">
    <div class="form-group mb-3">
        <label class="form-label">Monto Solicitado</label>
        <input type="number" step="0.01" name="montoSolicitado" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Registrar Solicitud</button>
</form>

<a asp-action="Mis" class="btn btn-secondary mt-3">Ver mis solicitudes</a>