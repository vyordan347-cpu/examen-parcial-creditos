@model IEnumerable<GestionCreditos.Models.Notificacion>

@{
    ViewData["Title"] = "Mis Notificaciones";
}

<h1>Mis Notificaciones</h1>

@if (Model.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Mensaje</th>
                <th>Solicitud</th>
                <th>Fecha</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td>@n.Texto</td>
                    <td><a asp-action="Detalle" asp-route-id="@n.SolicitudId">Ver solicitud #@n.SolicitudId</a></td>
                    <td>@n.FechaProcesamientoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No tienes notificaciones todavía.</p>
}